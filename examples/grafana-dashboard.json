        },
        {
          "expr": "sum by (modem, interface) (rate(modem_interface_tx_errors_total{job=~\"$job\", modem=~\"$modem\"}[5m]))",
          "legendFormat": "{{interface}} tx errors",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum by (modem, interface) (rate(modem_interface_rx_crc_errors_total{job=~\"$job\", modem=~\"$modem\"}[5m]))",
          "legendFormat": "{{interface}} rx crc errors",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum by (modem, interface) (rate(modem_interface_rx_drops_total{job=~\"$job\", modem=~\"$modem\"}[5m]))",
          "legendFormat": "{{interface}} rx drops",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum by (modem, interface) (rate(modem_interface_tx_drops_total{job=~\"$job\", modem=~\"$modem\"}[5m]))",
          "legendFormat": "{{interface}} tx drops",
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
