# Copy to .env and fill in.  .env is git-ignored.
MODEM_URL=https://192.168.1.1
MODEM_USERNAME=admin
MODEM_PASSWORD=your-modem-password

# Optional: reach the modem through a proxy (socks5h:// resolves DNS via the proxy)
# MODEM_PROXY=socks5://user:pass@proxy-host:1080

# Optional overrides (defaults shown):
# MODEM_NAME=                      # value of the `modem` label (default: host from MODEM_URL)
# DRIVER=auto                      # auto | dzs | html
# LISTEN_PORT=9877
# SCRAPE_TIMEOUT=10
# CACHE_SECONDS=30
# VERIFY_TLS=false
# LOGOUT_AFTER_SCRAPE=true
# LOGIN_BACKOFF_SECONDS=300
# LOG_LEVEL=INFO

# html driver only (non-DZS modems) - see README "Other modems":
# PAGES=/status/device.html,/status/pon.html
# MAX_PAGES=80
# REDISCOVER_SECONDS=3600
# EXCLUDE_PATTERNS=wifi,voip
# LOGIN_PATH=/cgi-bin/login.cgi
# LOGIN_USER_FIELD=username
# LOGIN_PASS_FIELD=password
# LOGIN_EXTRA_FIELDS=action=login
# PASSWORD_ENCODING=plain          # plain | base64 | md5 | sha256
